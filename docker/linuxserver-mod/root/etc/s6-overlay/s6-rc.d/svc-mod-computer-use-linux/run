#!/usr/bin/with-contenv bash

if [ -n "${COMPUTER_USE_LINUX_MCP_DISABLED}" ] || [ -z "${COMPUTER_USE_LINUX_MCP_TOKEN}" ]; then
  echo "computer-use-linux: COMPUTER_USE_LINUX_MCP_TOKEN is not set; MCP server disabled"
  s6-svc -Od .
  exit 0
fi

compositor=""
for _ in $(seq 1 120); do
  for candidate in $(pgrep -x kwin_wayland || true) $(pgrep -x labwc || true); do
    owner=$(ps -o user= -p "${candidate}" | tr -d ' ')
    if [ "${owner}" = "abc" ]; then
      compositor="${candidate}"
      break 2
    fi
  done
  sleep 0.5
done
if [ -z "${compositor}" ]; then
  echo "computer-use-linux: no abc-owned kwin_wayland or labwc"
  exit 1
fi

while IFS= read -r item; do
  key="${item%%=*}"
  value="${item#*=}"
  case "${key}" in
    DBUS_SESSION_BUS_ADDRESS | WAYLAND_DISPLAY | XDG_RUNTIME_DIR | DISPLAY)
      export "${key}=${value}"
      printf '%s' "${value}" > "/run/s6/container_environment/${key}"
      ;;
    # Session identity picks the KWin/labwc paths; export only, so other services keep theirs.
    XDG_CURRENT_DESKTOP | XDG_SESSION_TYPE | XDG_SESSION_DESKTOP | DESKTOP_SESSION)
      export "${key}=${value}"
      ;;
  esac
done < <(s6-setuidgid abc sh -c "tr '\\0' '\\n' < /proc/${compositor}/environ")
# True once the compositor itself listens on $1. A stale socket file left in
# /config/.XDG has no /proc/net/unix entry, and pixelflux's own wayland-N
# belongs to another process. Reading /proc/<pid>/fd needs the owner, abc.
compositor_listens_on() {
  local inode
  inode=$(awk -v path="$1" '$6 == "01" && $8 == path { print $7 }' /proc/net/unix)
  [ -n "${inode}" ] || return 1
  # shellcheck disable=SC2016 # the pid arrives as "$1", never spliced into the script
  s6-setuidgid abc sh -c 'readlink /proc/"$1"/fd/* 2>/dev/null' sh "${compositor}" |
    grep -Fqx "socket:[${inode}]"
}

# The compositor process exists before its session socket does (labwc took
# ~110 ms on 30 Oct 2026); losing that race left the server and overlay on
# the outer pixelflux output. Exiting lets s6 restart the service and retry.
socket="${XDG_RUNTIME_DIR}/wayland-0"
listening=""
for _ in $(seq 1 50); do
  if compositor_listens_on "${socket}"; then
    listening=1
    break
  fi
  sleep 0.1
done
if [ -z "${listening}" ]; then
  echo "computer-use-linux: compositor ${compositor} is not listening on ${socket}"
  exit 1
fi
export WAYLAND_DISPLAY=wayland-0
printf '%s' wayland-0 > /run/s6/container_environment/WAYLAND_DISPLAY

s6-setuidgid abc dbus-send --session --dest=org.a11y.Bus --type=method_call \
  /org/a11y/bus org.freedesktop.DBus.Properties.Set \
  string:org.a11y.Status string:IsEnabled variant:boolean:true || true

comm=$(s6-setuidgid abc sh -c "tr '\\0' '\\n' < /proc/${compositor}/comm")
if [ "${comm}" = "labwc" ]; then
  if ! s6-setuidgid abc dbus-send --session --print-reply --dest=org.freedesktop.DBus \
    /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner \
    string:org.a11y.atspi.Registry 2>/dev/null | grep -q 'boolean true'; then
    registry=/usr/libexec/at-spi2-registryd
    [ -x "${registry}" ] || registry=/usr/lib/at-spi2/at-spi2-registryd
    if [ -x "${registry}" ]; then
      s6-setuidgid abc "${registry}" &
    fi
  fi
fi

(
  while kill -0 "${compositor}" 2>/dev/null; do
    sleep 1
  done
  kill $$ 2>/dev/null || true
) &

exec s6-setuidgid abc /usr/local/bin/computer-use-linux mcp \
  --listen "${COMPUTER_USE_LINUX_MCP_LISTEN:-0.0.0.0:5200}"
